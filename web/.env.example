# Copy to .env.local — never commit real values.
# Do NOT put API key files (e.g. APIs.txt) in git.
#
# CLI scripts (`npm run l402`, `pay:invoice`, `agent:e2e`) load `web/.env` then
# `web/.env.local` automatically so MDK_* and AGENT_API_KEY work without `export`.

# --- MoneyDevKit (Lightning checkout + L402) ---
MDK_ACCESS_TOKEN=
MDK_MNEMONIC=
# Optional: seconds to wait for outbound payment (scripts/pay-invoice, agent:e2e)
# MDK_PAY_WAIT_SECS=120
# Set to 1 for noisy LDK trace logs when debugging payments
# MDK_VERBOSE_LIGHTNING=1

# --- App ---
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# --- Supabase Auth (Next.js middleware + dashboards) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Neon (agent marketplace DB) ---
# npm run db:push
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# --- Agent API (mutating routes) ---
# Generate: openssl rand -hex 32
AGENT_API_KEY=
# Set true to enforce L402 payment on /api/v1/invoke (requires MDK_* set)
INVOKE_REQUIRE_L402=false

# --- Provider keys (server-side; used by /api/v1/invoke) ---
OPENROUTER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_KEY=
RESEND_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# Optional email (architecture)
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
