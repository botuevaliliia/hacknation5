**/.env
**/.env.*
!**/.env.example

# Node / Next (web app)
web/node_modules/
web/.next/
web/out/
web/build/
web/.vercel
web/*.tsbuildinfo
web/npm-debug.log*
web/yarn-error.log*
web/.pnp
web.pnp.*

# Optional large local artifacts
*.log
